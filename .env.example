# Server
PORT=3000
NODE_ENV=development

# Auth (JWT) — set JWT_SECRET in every deployed environment
JWT_SECRET=change-me-to-a-long-random-string
# Token TTL is configured in auth.module (default 604800 seconds = 7 days).

# Local upload root for MVP (object storage later). Path is created automatically.
UPLOAD_STORAGE_ROOT=

# Anthropic Claude — funnel text generation (MVP)
# Replace with your real key from https://console.anthropic.com/ (do not commit real keys to git)
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME_paste_your_key_here
# Optional model id (default used if unset: claude-haiku-4-5)
ANTHROPIC_MODEL=claude-haiku-4-5

# claudeAPI / Swagger UI: served at /api/v1/docs when enabled (default on).
SWAGGER_ENABLED=true
# Base URL of your deployed API (no trailing slash). Improves "Try it out" in Swagger UI.
# PUBLIC_URL=https://your-service.onrender.com

# PostgreSQL (copy to .env and adjust)
# On Render: link the DB to the web service, or paste Internal Database URL here.
# If set, this wins over DB_HOST / DB_PORT / DB_USERNAME / DB_PASSWORD / DB_NAME.
# DATABASE_URL=postgres://user:password@host:5432/dbname
# DB_URL is accepted as an alias for DATABASE_URL (paste one full URL, single line).

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=REPLACE_ME_postgres_password
DB_NAME=flowbrand_marketing

# TypeORM: only true in local dev — use migrations in production
TYPEORM_SYNC=false
