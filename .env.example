# Server
PORT=3000
NODE_ENV=development

# OpenAPI / Swagger UI: served at /api/docs when enabled (default on).
# Set to false to disable Swagger (e.g. locked-down production).
SWAGGER_ENABLED=true
# Base URL of your deployed API (no trailing slash). Improves "Try it out" in Swagger UI.
# PUBLIC_URL=https://your-service.onrender.com

# PostgreSQL (copy to .env and adjust)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=flowbrand_marketing

# TypeORM: only true in local dev — use migrations in production
TYPEORM_SYNC=false
